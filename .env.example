# Скопируйте в .env и заполните. Файл .env НЕЛЬЗЯ коммитить и публиковать.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Числовой Telegram user_id владельца (узнать: @userinfobot). Только он сможет пользоваться ботом.
OWNER_ID=

# --- VK ---
# Пользовательский токен ОБЫЧНОГО аккаунта (НЕ руководителя сообщества!), права: wall, photos, offline.
# Подробности — README, раздел «Подключение VK API».
VK_USER_TOKEN=
# ID сообщества (число, без минуса)
VK_GROUP_ID=
# Необязательно: токен руководителя сообщества, ТОЛЬКО для проверки, что запись попала в предложенные
# (используется для чтения wall.get/wall.getById, ничего не публикует).
VK_ADMIN_TOKEN=
# Версия VK API
VK_API_VERSION=5.199
# Разрешить отправку при «открытой» стене (по умолчанию бот отказывается — см. README)
VK_ALLOW_OPEN_WALL=false

# --- База данных ---
# Пусто — локальный файл SQLite в DATA_DIR (для своего сервера/ПК).
# Для Render (бесплатный тариф) ОБЯЗАТЕЛЬНО укажите строку подключения к Postgres (например, Neon):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Время ---
TIMEZONE=Europe/Moscow
# Время отправки ВСЕХ постов (ЧЧ:ММ по TIMEZONE). Выбора времени в боте нет.
SEND_TIME=11:00
# Время ежедневного отчёта (ЧЧ:ММ по TIMEZONE)
REPORT_TIME=11:00
# Как часто проверять расписание в «окне отправки» — в течение двух часов после SEND_TIME (сек.;
# делитель 60: 5, 6, 10, 12, 15, 20, 30, 60). Вне окна база не опрашивается.
TICK_SECONDS=30
# Если сервер был недоступен дольше этого срока после времени отправки — запись НЕ отправляется «задним числом»
MISSED_GRACE_MINUTES=120

# --- Render / хостинг (на своём сервере не нужны) ---
# PORT выставляет сам Render; при заданном PORT бот отвечает на GET /health.
# PORT=10000
# Публичный адрес сервиса для самопроверки (Render подставляет RENDER_EXTERNAL_URL сам).
# SELF_PING_URL=https://gray-editor.onrender.com
# Писать владельцу «GRAY Editor запущен» при каждом старте (на Render лучше false)
STARTUP_NOTIFY=true

EDITOR_NAME=Winston_Goodman
LOG_LEVEL=INFO
# Каталог данных (SQLite, резервные копии, временные файлы). В Docker оставьте data
DATA_DIR=data
